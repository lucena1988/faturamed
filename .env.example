ADMIN_INITIAL_EMAIL=admin@faturamed.local
# Set a unique password of at least 12 characters before the first startup.
ADMIN_INITIAL_PASSWORD=
SESSION_COOKIE_SECURE=false
# E-mail para a recuperacao de senha (SMTP). Ex.: Gmail com senha de app: smtp.gmail.com / 587.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
# Apenas local, sem SMTP: mostra o codigo no log do servidor. Deixe false em HML/producao.
RECUPERACAO_CODIGO_NO_LOG=false
